# Copy to .env.receipt.local (ignored by Git). These are Node test settings, never VITE_*.
OPENROUTER_API_KEY=
# Run npm run test:receipt:models with the key first, then copy exact eligible IDs here.
OPENROUTER_VISION_MODEL=
OPENROUTER_TRANSFER_MODEL=
# Manifest paths are relative to the repository; image paths are relative to their manifest.
RECEIPT_TEST_CASES=tests/fixtures/receipts/gold.json
# Optional benchmark mode: lowest (default), off, or compare (both, where supported).
# RECEIPT_BENCHMARK_REASONING=compare

# Optional repeated model comparison: 1 (default) to 10 rounds per role/model.
# RECEIPT_BENCHMARK_REPETITIONS=3
