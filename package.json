{
  "name": "conspectus-mobile",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5173 --strictPort",
    "build": "vite build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs --dist dist --budget-config bundle-size-budgets.json",
    "check:dead-code": "knip",
    "check:local": "node scripts/run-local-quality.mjs",
    "check:lighthouse": "node scripts/run-lighthouse-ci.mjs --budget-config lighthouse-budgets.json",
    "preview": "vite preview",
    "prepare": "husky",
    "audit:dependencies": "npm audit --audit-level=high",
    "precommit:quick": "lint-staged",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run && vitest run --config vitest.scripts.config.ts",
    "test:changed": "vitest run --changed=origin/main --passWithNoTests && vitest run --config vitest.scripts.config.ts --changed=origin/main --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium --project=iphone-13-safari --grep @smoke",
    "test:e2e:webkit": "playwright test --project=iphone-13-safari --fully-parallel --workers=2",
    "test:receipt": "vitest run src/features/receipt src/openrouter src/features/app-shell/receiptTransferCommitController.test.ts src/features/app-shell/writeSafety.integration.test.ts src/db/transferWriteService.test.ts",
    "test:receipt:e2e": "playwright test tests/e2e/receipt-capture.spec.ts tests/e2e/openrouter-settings.spec.ts",
    "test:receipt:check": "tsc --project tsconfig.receipt.json && vitest run --config vitest.receipt.config.ts --testNamePattern=offline:",
    "test:receipt:models": "vitest run --config vitest.receipt.config.ts --testNamePattern=catalog:",
    "test:receipt:live": "vitest run --config vitest.receipt.config.ts --testNamePattern=live:",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:receipt:benchmark": "vitest run --config vitest.receipt.config.ts --testNamePattern=benchmark:",
    "test:receipt:image-sizes": "vitest run --config vitest.receipt.config.ts --testNamePattern=image-sizes:"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/sql.js": "^1.4.10",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lighthouse": "13.5.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.4.0",
    "dexie": "^4.3.0",
    "sql.js": "^1.14.1",
    "svelte-i18n": "^4.0.1"
  },
  "overrides": {
    "filelist": "2.0.2"
  }
}
